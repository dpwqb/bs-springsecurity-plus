<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.codermy.myspringsecurityplus.resource.dao.DownloadDao">

    <!-- 保存下载记录 -->
    <insert id="save" parameterType="com.codermy.myspringsecurityplus.resource.entity.DownloadRecord">
        INSERT INTO download_record
        (resource_id, user_id, user_name, resource_title, download_time, ip_address)
        VALUES
        (#{resourceId}, #{userId}, #{userName}, #{resourceTitle}, #{downloadTime}, #{ipAddress})
    </insert>

    <!-- 查询用户的下载记录 -->
    <select id="getDownloadRecordsByUserId" resultType="com.codermy.myspringsecurityplus.resource.entity.DownloadRecord">
        SELECT * FROM download_record
        WHERE user_id = #{userId}
        ORDER BY download_time DESC
    </select>

    <!-- 查询资源的下载记录 -->
    <select id="getDownloadRecordsByResourceId" resultType="com.codermy.myspringsecurityplus.resource.entity.DownloadRecord">
        SELECT * FROM download_record WHERE resource_id = #{resourceId}
    </select>

    <!-- 统计用户下载次数 -->
    <select id="countDownloadsByUserId" resultType="long">
        SELECT COUNT(*) FROM download_record WHERE user_id = #{userId}
    </select>

    <!-- 统计今日下载次数 -->
    <select id="countTodayDownloads" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM download_record
        WHERE DATE(download_time) = CURDATE()
    </select>

    <!-- 删除指定资源的所有下载记录 -->
    <delete id="deleteByResourceId">
        DELETE FROM download_record WHERE resource_id = #{resourceId}
    </delete>

    <!-- 分页查询所有下载记录（管理员） -->
    <select id="getDownloadRecordsForAdmin" resultType="com.codermy.myspringsecurityplus.resource.entity.DownloadRecord">
        SELECT * FROM download_record
        <where>
            <if test="params.userName != null and params.userName != ''">
                AND user_name LIKE CONCAT('%', #{params.userName}, '%')
            </if>
            <if test="params.resourceTitle != null and params.resourceTitle != ''">
                AND resource_title LIKE CONCAT('%', #{params.resourceTitle}, '%')
            </if>
            <if test="params.startTime != null">
                AND download_time &gt;= #{params.startTime}
            </if>
            <if test="params.endTime != null">
                AND download_time &lt;= #{params.endTime}
            </if>
            <if test="params.ipAddress != null and params.ipAddress != ''">
                AND ip_address LIKE CONCAT('%', #{params.ipAddress}, '%')
            </if>
        </where>
        ORDER BY download_time DESC
    </select>

    <!-- 统计总记录数 -->
    <select id="countDownloadRecords" resultType="java.lang.Long">
        SELECT COUNT(*) FROM download_record
        <where>
            <if test="params.userName != null and params.userName != ''">
                AND user_name LIKE CONCAT('%', #{params.userName}, '%')
            </if>
            <if test="params.resourceTitle != null and params.resourceTitle != ''">
                AND resource_title LIKE CONCAT('%', #{params.resourceTitle}, '%')
            </if>
            <if test="params.startTime != null">
                AND download_time &gt;= #{params.startTime}
            </if>
            <if test="params.endTime != null">
                AND download_time &lt;= #{params.endTime}
            </if>
            <if test="params.ipAddress != null and params.ipAddress != ''">
                AND ip_address LIKE CONCAT('%', #{params.ipAddress}, '%')
            </if>
        </where>
    </select>

    <!-- 删除单条下载记录 -->
    <delete id="deleteByRecordId">
        DELETE FROM download_record WHERE record_id = #{recordId}
    </delete>

    <!-- 批量删除下载记录 -->
    <delete id="batchDelete">
        DELETE FROM download_record WHERE record_id IN
        <foreach collection="recordIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 删除所有下载记录 -->
    <delete id="deleteAll">
        DELETE FROM download_record
    </delete>

</mapper>
