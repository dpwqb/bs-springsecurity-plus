<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.codermy.myspringsecurityplus.resource.dao.ResourceCategoryDao">

    <!-- 查询所有分类 -->
    <select id="getAllCategories" resultType="com.codermy.myspringsecurityplus.resource.entity.ResourceCategory">
        SELECT * FROM resource_category ORDER BY sort_order ASC
    </select>

    <!-- 根据父ID查询子分类 -->
    <select id="getCategoriesByParentId" resultType="com.codermy.myspringsecurityplus.resource.entity.ResourceCategory">
        SELECT * FROM resource_category WHERE parent_id = #{parentId} ORDER BY sort_order ASC
    </select>

    <!-- 根据ID查询分类 -->
    <select id="getCategoryById" resultType="com.codermy.myspringsecurityplus.resource.entity.ResourceCategory">
        SELECT * FROM resource_category WHERE category_id = #{categoryId}
    </select>

    <!-- 保存分类 -->
    <insert id="save" parameterType="com.codermy.myspringsecurityplus.resource.entity.ResourceCategory">
        INSERT INTO resource_category
        (parent_id, category_name, description, icon, sort_order, status)
        VALUES
        (#{parentId}, #{categoryName}, #{description}, #{icon}, #{sortOrder}, #{status})
    </insert>

    <!-- 更新分类 -->
    <update id="update" parameterType="com.codermy.myspringsecurityplus.resource.entity.ResourceCategory">
        UPDATE resource_category
        <set>
            <if test="parentId != null">
                parent_id = #{parentId},
            </if>
            <if test="categoryName != null and categoryName != ''">
                category_name = #{categoryName},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
            <if test="icon != null">
                icon = #{icon},
            </if>
            <if test="sortOrder != null">
                sort_order = #{sortOrder},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            update_time = NOW()
        </set>
        WHERE category_id = #{categoryId}
    </update>

    <!-- 删除分类 -->
    <delete id="delete">
        DELETE FROM resource_category WHERE category_id = #{categoryId}
    </delete>

    <!-- 检查分类名称是否唯一 -->
    <select id="checkCategoryNameUnique" resultType="com.codermy.myspringsecurityplus.resource.entity.ResourceCategory">
        SELECT * FROM resource_category WHERE category_name = #{categoryName}
        <if test="categoryId != null">
            AND category_id != #{categoryId}
        </if>
        LIMIT 1
    </select>

</mapper>
