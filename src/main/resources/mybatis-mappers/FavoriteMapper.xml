<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.codermy.myspringsecurityplus.resource.dao.FavoriteDao">

    <!-- 保存收藏记录 -->
    <insert id="save" parameterType="com.codermy.myspringsecurityplus.resource.entity.FavoriteRecord">
        INSERT INTO favorite_record
        (user_id, resource_id)
        VALUES
        (#{userId}, #{resourceId})
    </insert>

    <!-- 删除收藏记录 -->
    <delete id="delete">
        DELETE FROM favorite_record
        WHERE user_id = #{userId} AND resource_id = #{resourceId}
    </delete>

    <!-- 查询用户的收藏记录 -->
    <select id="getFavoriteRecordsByUserId" resultType="com.codermy.myspringsecurityplus.resource.entity.FavoriteRecord">
        SELECT f.* FROM favorite_record f
        WHERE f.user_id = #{userId}
        ORDER BY f.create_time DESC
    </select>

    <!-- 检查是否已收藏 -->
    <select id="checkFavorited" resultType="com.codermy.myspringsecurityplus.resource.entity.FavoriteRecord">
        SELECT * FROM favorite_record
        WHERE user_id = #{userId} AND resource_id = #{resourceId}
        LIMIT 1
    </select>

    <!-- 统计资源收藏次数 -->
    <select id="countFavoritesByResourceId" resultType="long">
        SELECT COUNT(*) FROM favorite_record WHERE resource_id = #{resourceId}
    </select>

</mapper>
